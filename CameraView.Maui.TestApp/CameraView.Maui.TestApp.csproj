<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TestAppDotNetVersion Condition="'$(TestAppDotNetVersion)' == ''">10.0</TestAppDotNetVersion>
    <TargetFrameworks>net$(TestAppDotNetVersion)-android;net$(TestAppDotNetVersion)-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CameraView.Maui.TestApp</RootNamespace>
    <AssemblyName>CameraView.Maui.TestApp</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <MauiVersion>9.0.120</MauiVersion>
    <MauiVersion Condition="'$(TargetFramework)' == 'net10.0-android' Or '$(TargetFramework)' == 'net10.0-ios'">10.0.90</MauiVersion>
    <LoggingVersion>9.0.5</LoggingVersion>
    <LoggingVersion Condition="'$(TargetFramework)' == 'net10.0-android' Or '$(TargetFramework)' == 'net10.0-ios'">10.0.0</LoggingVersion>

    <ApplicationTitle>CameraView Test</ApplicationTitle>
    <ApplicationId>it.polecola.cameraview.testapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(LoggingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraView.Maui\CameraView.Maui.csproj" />
  </ItemGroup>
</Project>
