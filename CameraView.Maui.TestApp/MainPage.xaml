<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:camera="clr-namespace:CameraView.Maui;assembly=CameraView.Maui"
             x:Class="CameraView.Maui.TestApp.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">
        <camera:CameraView x:Name="CameraPreview"
                           Grid.Row="0"
                           Camera="Rear"
                           Orientation="Portrait"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill">
            <camera:CameraView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPreviewTapped" />
            </camera:CameraView.GestureRecognizers>
        </camera:CameraView>

        <Border Grid.Row="1"
                BackgroundColor="#E6191919"
                StrokeThickness="0"
                Padding="16,12">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="StateLabel"
                       Text="Stato: Stopped"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="StatusLabel"
                       Text="In attesa del primo frame…"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="ConfigurationLabel"
                       Text="Configurazione: in attesa"
                       FontSize="12"
                       TextColor="#FFBDBDBD"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="ControlsLabel"
                       Text="Controlli: in attesa"
                       FontSize="12"
                       TextColor="#FFBDBDBD"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       TextColor="#FFFF8A80"
                       HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Cambia camera"
                            Clicked="OnSwitchCameraClicked" />
                    <Button x:Name="ToggleButton"
                            Grid.Column="1"
                            Text="Disattiva"
                            Clicked="OnToggleCameraClicked" />
                    <Button x:Name="OrientationButton"
                            Grid.Column="2"
                            Text="Landscape"
                            Clicked="OnToggleOrientationClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Default"
                            CommandParameter="Default"
                            Clicked="OnCaptureProfileClicked" />
                    <Button Grid.Column="1"
                            Text="Low"
                            CommandParameter="Low"
                            Clicked="OnCaptureProfileClicked" />
                    <Button Grid.Column="2"
                            Text="Balanced"
                            CommandParameter="Balanced"
                            Clicked="OnCaptureProfileClicked" />
                    <Button Grid.Column="3"
                            Text="Custom"
                            CommandParameter="Custom"
                            Clicked="OnCaptureProfileClicked" />
                    <Button Grid.Column="4"
                            Text="Raw"
                            CommandParameter="Realtime"
                            Clicked="OnCaptureProfileClicked" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="Zoom"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                    <Slider x:Name="ZoomSlider"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="1"
                            Value="1"
                            ValueChanged="OnZoomChanged" />
                    <Label x:Name="ZoomLabel"
                           Grid.Column="2"
                           Text="1.00x"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="EV"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                    <Slider x:Name="ExposureSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="0"
                            Value="0"
                            ValueChanged="OnExposureChanged" />
                    <Label x:Name="ExposureLabel"
                           Grid.Column="2"
                           Text="0.00"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button x:Name="TorchButton"
                            Grid.Column="0"
                            Text="Torcia: off"
                            Clicked="OnToggleTorchClicked" />
                    <Button Grid.Column="1"
                            Text="Focus auto"
                            Clicked="OnResetFocusClicked" />
                    <Button x:Name="MirroringButton"
                            Grid.Column="2"
                            Text="Mirror: auto"
                            Clicked="OnToggleMirroringClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
